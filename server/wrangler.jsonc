{
  "$schema": "../../.deploy-tools/node_modules/wrangler/config-schema.json",
  "name": "project-touchline-arena",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "durable_objects": {"bindings": [{"name":"ROOMS","class_name":"TouchlineRoom"}]},
